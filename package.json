{
  "name": "capsulabits",
  "version": "1.0.0",
  "description": "Landing page de CAPSULABITS - Beer, Games & Snacks (Saltillo)",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "build": "tailwindcss -i ./css/input.css -o ./css/styles.css --minify",
    "dev": "tailwindcss -i ./css/input.css -o ./css/styles.css --watch",
    "check:responsive": "node scripts/check-responsive.mjs",
    "check:functional": "node scripts/check-functional.mjs",
    "check": "npm run check:responsive && npm run check:functional"
  },
  "devDependencies": {
    "puppeteer-core": "^25.12.0",
    "tailwindcss": "^3.4.17"
  }
}
